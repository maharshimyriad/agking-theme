{% assign email = block.settings.email | strip %}
{% assign phone = block.settings.phone | strip %}
{% assign phone_link = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}

{% if email != blank or phone != blank %}
  <div class="announcement-bar__contact" {{ block.shopify_attributes }}>
    <ul class="announcement-bar__contact-list">
      {% if email != blank %}
        <li>
          <a class="announcement-bar__contact-link" href="mailto:{{ email | escape }}">
            {% if block.settings.show_icons %}
              <span class="announcement-bar__contact-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                  <path d="M1.5 3.5A1.5 1.5 0 0 1 3 2h10a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 13 14H3a1.5 1.5 0 0 1-1.5-1.5zm1.7.1L8 7.1l4.8-3.5zM13 5l-4.6 3.3a.7.7 0 0 1-.8 0L3 5v7.5h10z" />
                </svg>
              </span>
            {% endif %}
            {{- email | escape -}}
          </a>
        </li>
      {% endif %}
      {% if phone != blank %}
        <li>
          <a class="announcement-bar__contact-link" href="tel:{{ phone_link | escape }}">
            {% if block.settings.show_icons %}
              <span class="announcement-bar__contact-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                  <path d="M4.1 1.5h-2A1.6 1.6 0 0 0 .5 3.1c0 6.8 5.6 12.4 12.4 12.4a1.6 1.6 0 0 0 1.6-1.6v-2a1 1 0 0 0-.8-1l-3.1-.7a1 1 0 0 0-1 .4l-.7.9a10.2 10.2 0 0 1-4.4-4.4l.9-.7a1 1 0 0 0 .4-1l-.7-3.1a1 1 0 0 0-1-.8" />
                </svg>
              </span>
            {% endif %}
            {{- phone | escape -}}
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
{% endif %}

{% schema %}
{
  "name": "Contact details",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "sales@agking.com.au"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "1300 757 274"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show contact icons",
      "default": true
    }
  ]
}
{% endschema %}